    "description": "מחבר ה-OpenClaw הרשמי והישיר של Legalix Engineering — מעניק ל-ChatGPT חיבור קבוע ומזוהה לכל יכולות OpenClaw בענן."
  },
  "servers": [
    {
      "url": "https://inclusion-refer-maintenance-associations.trycloudflare.com"
    }
