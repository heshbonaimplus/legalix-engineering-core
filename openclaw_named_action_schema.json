                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "agent": { "type": "string" },
                    "openclaw_connected": { "type": "boolean" },
                    "openclaw_response": { "type": "string" }
                  }
                }
              }
            }
          }
